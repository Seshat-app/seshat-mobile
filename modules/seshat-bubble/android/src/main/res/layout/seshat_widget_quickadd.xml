<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/seshat_widget_bg" android:orientation="horizontal" android:padding="6dp">
  <LinearLayout android:id="@+id/sw_qa_add" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:background="@drawable/seshat_widget_tile_gold" android:gravity="center" android:orientation="vertical">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+" android:textColor="#0D0D0D" android:textSize="22sp" android:textStyle="bold"/>
    <TextView android:id="@+id/sw_qa_add_t" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#0D0D0D" android:textSize="11sp" android:textStyle="bold"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/sw_qa_receipt" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:background="@drawable/seshat_widget_tile" android:gravity="center" android:orientation="vertical">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="&#9635;" android:textColor="#D4AF37" android:textSize="22sp" android:textStyle="bold"/>
    <TextView android:id="@+id/sw_qa_receipt_t" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#EDE6D6" android:textSize="11sp" android:textStyle="bold"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/sw_qa_chat" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:background="@drawable/seshat_widget_tile" android:gravity="center" android:orientation="vertical">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="&#10022;" android:textColor="#D4AF37" android:textSize="22sp" android:textStyle="bold"/>
    <TextView android:id="@+id/sw_qa_chat_t" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#EDE6D6" android:textSize="11sp" android:textStyle="bold"/>
  </LinearLayout>
</LinearLayout>
